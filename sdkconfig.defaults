# ESP32 конфигурация по умолчанию для gas_boiler

# FreeRTOS trace + runtime stats (для CPU load в главном цикле)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Частота CPU — максимальная производительность
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Размер стека задач
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# WiFi
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8

# HTTP сервер — увеличить лимиты
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# esp_timer ISR dispatch (нужен для OpenTherm таймера с минимальной задержкой)
CONFIG_ESP_TIMER_SUPPORTS_ISR_DISPATCH_METHOD=y

# GPIO функции в IRAM (нужно для OT таймера: во время NVS flash-записи кеш отключён,
# но 500мкс ISR вызывает gpio_set_level — без IRAM будет panic)
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

# Логирование
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Кастомная таблица разделов (добавлен coredump раздел)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Core dump to flash — сохраняет crash-инфо (стектрейс, причина) на flash
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_LOGGING=n

# Оптимизация Flash: сжатие и скорость
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# TCP buffer sizes
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=8192
CONFIG_LWIP_TCP_WND_DEFAULT=5760

# lwip SO_LINGER — мгновенное освобождение сокетов (RST вместо FIN, без TIME_WAIT)
CONFIG_LWIP_SO_LINGER=y
# TIME_WAIT: 120с → 10с (защита если SO_LINGER не сработал)
CONFIG_LWIP_TCP_MSL=5000

# ── OTA A/B: флеш 4МБ, слоты ota_0/ota_1 по 1.5МБ, rollback support ──
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_APP_ROLLBACK_ENABLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Снижение TLS-буферов (экономия ~10KB DRAM)
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
# Динамические буферы mbedTLS и MFLN
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_SSL_MAX_FRAGMENT_LENGTH=y
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
# Только TLS 1.2 (1.3 жрёт в 1.5-2x больше RAM)
# CONFIG_MBEDTLS_SSL_PROTO_TLS1_3 is not set (оставить по умолчанию)
# Запрет сессионных тикетов и пересогласования
CONFIG_MBEDTLS_CLIENT_SSL_SESSION_TICKETS=n
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=n
